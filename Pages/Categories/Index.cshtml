@page
@model Marincas_Bianca_Lab2.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}
<h1>Categories</h1>
<p><a asp-page="Create">Create New</a></p>
<table class="table">
    <thead><tr><th>ID</th><th>Category</th></tr></thead>
    <tbody>
        @foreach (var item in Model.Category)
        {
            <tr><td>@item.ID</td><td>@item.CategoryName</td></tr>
        }
    </tbody>
</table>