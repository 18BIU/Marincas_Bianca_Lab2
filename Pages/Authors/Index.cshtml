@page
@model Marincas_Bianca_Lab2.Pages.Authors.IndexModel
@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>
<p><a asp-page="Create">Create New</a></p>
<table class="table">
    <thead>
        <tr><th>First Name</th><th>Last Name</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Author)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td><a asp-page="./Edit" asp-route-id="@item.ID">Edit</a></td>
            </tr>
        }
    </tbody>
</table>